{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rkalema/evidence-first-root-cause/schemas/root_cause_output.schema.json",
  "title": "Evidence-First Root Cause Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "problem",
    "signal_validation",
    "observations",
    "hypotheses",
    "leading_explanation",
    "confidence",
    "impact",
    "unknowns",
    "recommended_actions",
    "validation_plan"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "root_cause_supported",
        "multiple_contributors_supported",
        "insufficient_evidence",
        "data_quality_blocked"
      ]
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "metric", "baseline", "observed"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "metric": {"type": "string", "minLength": 1},
        "baseline": {"type": ["string", "number"]},
        "observed": {"type": ["string", "number"]},
        "period": {"type": "string"},
        "affected_population": {"type": "string"}
      }
    },
    "signal_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trustworthy", "checks", "notes"],
      "properties": {
        "trustworthy": {"type": "boolean"},
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "result"],
            "properties": {
              "check": {"type": "string", "minLength": 1},
              "result": {"type": "string", "minLength": 1}
            }
          }
        },
        "notes": {"type": "string"}
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "evidence"],
        "properties": {
          "statement": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis", "mechanism", "evidence_for", "evidence_against", "result"],
        "properties": {
          "hypothesis": {"type": "string", "minLength": 1},
          "mechanism": {"type": "string", "minLength": 1},
          "evidence_for": {"type": "array", "items": {"type": "string"}},
          "evidence_against": {"type": "array", "items": {"type": "string"}},
          "result": {
            "type": "string",
            "enum": ["supported", "partially_supported", "not_supported", "untested"]
          }
        }
      }
    },
    "leading_explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "evidence_class"],
      "properties": {
        "statement": {"type": "string"},
        "evidence_class": {
          "type": "string",
          "enum": ["observation", "inference", "conclusion", "unknown"]
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rationale"],
      "properties": {
        "level": {"type": "string", "enum": ["high", "medium", "low"]},
        "rationale": {"type": "string", "minLength": 1},
        "would_increase": {"type": "array", "items": {"type": "string"}},
        "would_reduce": {"type": "array", "items": {"type": "string"}}
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {"type": "string"},
        "measured": {"type": "array", "items": {"type": "string"}},
        "estimated": {"type": "array", "items": {"type": "string"}}
      }
    },
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "recommended_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containment", "corrective", "preventive", "investigation"],
      "properties": {
        "containment": {"type": "array", "items": {"type": "string"}},
        "corrective": {"type": "array", "items": {"type": "string"}},
        "preventive": {"type": "array", "items": {"type": "string"}},
        "investigation": {"type": "array", "items": {"type": "string"}}
      }
    },
    "validation_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_metric", "review_timing", "comparison_method", "success_criteria"],
      "properties": {
        "target_metric": {"type": "string", "minLength": 1},
        "review_timing": {"type": "string", "minLength": 1},
        "comparison_method": {"type": "string", "minLength": 1},
        "success_criteria": {"type": "string", "minLength": 1},
        "rollback_or_escalation": {"type": "string"}
      }
    }
  }
}
